{
  "name": "liz-baseline",
  "version": "0.1.0",
  "private": true,
  "description": "Liz's Day-0 Next.js template: Renovate + Sentry + OTel + Resend + Biome + vitest",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "ci": "biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.65.0",
    "@vercel/otel": "^2.1.2",
    "langfuse": "^3.38.6",
    "next": "^16.2.10",
    "posthog-node": "^5.41.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.17.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.0 <1",
      "postcss": ">=8.5.10 <9"
    }
  }
}
