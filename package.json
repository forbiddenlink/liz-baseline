{
  "name": "liz-baseline",
  "version": "0.1.0",
  "private": true,
  "description": "Liz's Day-0 Next.js template: Renovate + Sentry + OTel + Resend + Biome + vitest",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "ci": "biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.70.0",
    "@vercel/otel": "^2.1.2",
    "langfuse": "^3.38.6",
    "next": "^16.3.3",
    "posthog-node": "^5.51.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "^3.3.18",
      "sharp": ">=0.35.0 <1",
      "postcss": "^8.5.26"
    }
  }
}
